# --- Discogs ----------------------------------------------------------------
# Necessaires uniquement pour `pnpm sync`. Le build, lui, ne lit que
# data/collection.json et n'appelle rien.

# Le compte qui possede la collection.
DISCOGS_USERNAME=""

# Personal Access Token : Discogs > Settings > Developers > "Generate new token"
# https://www.discogs.com/settings/developers
DISCOGS_TOKEN=""

# --- Chemins ----------------------------------------------------------------
# Repertoire ou les pochettes sont telechargees pendant la synchronisation.
# La valeur par defaut les place dans public/, d'ou Next les copie dans la
# sortie statique ; les changer signifie qu'elles ne seront pas publiees.
COVERS_DIR="./public/covers"

# Chemin de base du site, "/records" pour un site de projet GitHub Pages, vide
# a la racine d'un domaine. Le workflow le demande a l'action configure-pages ;
# en local, le laisser vide.
BASE_PATH=""
