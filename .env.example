# --- Database ---------------------------------------------------------------
# SQLite file. Keep the default for local dev; docker-compose overrides it to
# a persistent volume (file:/data/records.db).
DATABASE_URL="file:./dev.db"

# Directory where album covers are cached locally (downloaded during sync).
# docker-compose overrides it to /data/covers (persistent volume).
COVERS_DIR="./data/covers"

# --- Discogs ----------------------------------------------------------------
# Your Discogs username (the account that owns the collection).
DISCOGS_USERNAME=""

# Personal Access Token: Discogs > Settings > Developers > "Generate new token"
# https://www.discogs.com/settings/developers
DISCOGS_TOKEN=""

# --- Admin auth -------------------------------------------------------------
# Initial admin password, hashed and stored in the database by the seed script
# on first launch. Change it later with: pnpm run reset-password
ADMIN_PASSWORD=""

# Secret used to encrypt the session cookie (iron-session).
# Must be at least 32 characters. Generate one with: openssl rand -base64 32
# REQUIRED in production: the server refuses to open a session without it.
SESSION_SECRET=""

# Whether the session cookie is Secure-only (HTTPS). Leave empty to use the
# safe default: Secure in production, not in development. Set to "false" only
# to run a production build over plain HTTP locally.
SESSION_SECURE=""

# --- Scheduled sync ---------------------------------------------------------
# Cron expression for the automatic daily Discogs sync (server local time).
SYNC_CRON="0 4 * * *"
